{
  "hosting": {
    "site": "xe-kho",
    "public": "dist",
    "predeploy": [
      "npm run cap:ota:bundle"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/dat-hang",
        "destination": "https://smart-menu-pos-v2.web.app/dat-hang",
        "type": 302
      },
      {
        "source": "/dat-mon",
        "destination": "https://smart-menu-pos-v2.web.app/dat-hang",
        "type": 302
      },
      {
        "source": "/order",
        "destination": "https://smart-menu-pos-v2.web.app/dat-hang",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/kitchen",
        "destination": "/kitchen.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "xekho"
    }
  ]
}
