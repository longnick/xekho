rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? userDoc().data.role
        : null;
    }

    function isAdmin() {
      return userRole() in ['admin', 'manager'];
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // `staffId` lives in users/{uid} and is provisioned only by the Admin SDK.
    // It is never a browser-writable claim, so it is safe as the binding for
    // limited staff attendance access.
    function hasStaffIdentity(staffId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.staffId == staffId;
    }

    function validOwnShiftCreate() {
      return hasStaffIdentity(request.resource.data.staffId)
        && request.resource.data.status == 'open'
        && request.resource.data.checkOutAt == null
        && request.resource.data.checkOutAtMs == null
        && request.resource.data.durationMinutes == null;
    }

    function validOwnShiftClose() {
      return hasStaffIdentity(resource.data.staffId)
        && resource.data.status == 'open'
        && request.resource.data.status == 'closed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'checkOutAt', 'checkOutAtMs', 'durationMinutes', 'status', 'checkoutLocation'
        ]);
    }

    // Role, UID↔staff mapping, disable state, and payroll fields are
    // server-owned. A signed-in client may only update this narrow self-profile
    // allowlist; account provisioning and role changes use a privileged callable.
    function validSelfUserProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName',
        'username',
        'photoURL',
        'fcmTokens',
        'pushPermission',
        'pushTokenUpdatedAt',
        'updatedAt'
      ]);
    }

    function isKitchen() {
      return userRole() == 'kitchen';
    }

    function isStaff() {
      return isAdmin() || isKitchen() || userRole() == 'staff';
    }

    function validPublicMenuWrite() {
      return request.resource.data.keys().hasAll([
        'display_name',
        'sell_price',
        'category',
        'imageMode'
      ]);
    }

    function validOrderRequestCreate() {
      return request.resource.data.keys().hasAll([
          'tableNumber',
          'items',
          'totalPrice',
          'status',
          'requestType',
          'source',
          'createdAt'
        ]) &&
        request.resource.data.status == 'pending_approval' &&
        request.resource.data.requestType == 'menu_order' &&
        request.resource.data.source == 'customer_web';
    }

    function validServiceRequestCreate() {
      return request.resource.data.type == 'call_staff';
    }

    function validPaymentRequestCreate() {
      return request.resource.data.status == 'requested';
    }

    match /public_menu/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && validPublicMenuWrite();
    }

    match /order_requests/{requestId} {
      allow create: if validOrderRequestCreate();
      allow get: if resource.data.source == 'customer_web';
      allow list: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /service_requests/{requestId} {
      allow create: if validServiceRequestCreate();
      allow get, list: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /payment_requests/{requestId} {
      allow create: if validPaymentRequestCreate();
      allow get, list: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /System_Logs/{logId} {
      allow create: if signedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /Staff/{staffId} {
      allow get: if isAdmin() || hasStaffIdentity(staffId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /attendance_daily/{docId} {
      // Staff may inspect only their mapped own records; payroll reconciliation
      // is manager/admin-only because amounts are business-critical.
      allow read: if isAdmin() || hasStaffIdentity(resource.data.staffId);
      allow create, update, delete: if isAdmin();
    }

    match /attendance_shifts/{docId} {
      allow read: if isAdmin() || hasStaffIdentity(resource.data.staffId);
      allow create: if isAdmin() || validOwnShiftCreate();
      allow update: if isAdmin() || validOwnShiftClose();
      allow delete: if isAdmin();
    }

    match /config/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      // Personnel-directory access is needed by the manager/admin UI. Ordinary
      // accounts may inspect only their own profile.
      allow get: if isSelf(userId) || isAdmin();
      allow list: if isAdmin();

      // Browser provisioning and direct role mutations are deliberately denied.
      // Admin SDK / the authenticated management callable writes these documents.
      allow create, delete: if false;
      allow update: if isSelf(userId) && validSelfUserProfileUpdate();
    }

    match /tables/{docId} {
      allow read: if signedIn();
      allow write: if signedIn() && !isKitchen();
    }

    match /orders/{docId} {
      allow read: if signedIn();
      allow create, delete: if signedIn() && !isKitchen();
      allow update: if (signedIn() && !isKitchen()) || (
        isKitchen() &&
        resource.data.status == 'open' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items'])
      );
    }

    match /menu/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /inventory/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /history/{docId} {
      allow read: if isAdmin();
      // Browser clients may create a completed record only through an
      // administrator/manager POS session. Final history is never mutable from
      // the browser; reconciliation/cancellation uses privileged backend code.
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /expenses/{docId} {
      allow read, write: if isAdmin();
    }

    match /purchases/{docId} {
      allow read, write: if isAdmin();
    }

    match /suppliers/{docId} {
      allow read, write: if isAdmin();
    }

    match /shiftLogs/{docId} {
      allow read, write: if isAdmin();
    }

    match /kitchen_notifications/{docId} {
      allow read: if signedIn();
      allow create: if isKitchen() || isAdmin();
      allow update: if signedIn();
      allow delete: if isAdmin();
    }

    match /aiHistory/{docId} {
      allow read, write: if signedIn();
    }

    match /media_assets/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /media_asset_tags/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /media_asset_scores/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /refined_media_assets/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /media_embeddings/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /unitConversions/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /pending_users/{docId} {
      allow read, write: if signedIn();
    }

    match /Product_Catalog/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /Inventory_Items/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /Recipes_BOM/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
