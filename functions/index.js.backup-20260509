function parseKitchenItemSummary(itemText = '') {
  const raw = String(itemText || '').trim();
  if (!raw) return null;

  const match = raw.match(/^(.*?)\s*x\s*(\d+(?:[.,]\d+)?)$/i);
  if (!match) {
    return {
      name: raw,
      qty: '',
      summary: raw,
    };
  }

  const name = String(match[1] || '').trim();
  const qty = String(match[2] || '').replace(',', '.').trim();
  return {
    name: name || raw,
    qty,
    summary: `${name || raw} x${qty}`,
  };
}

